<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.techparkuq.controlador.GestionAtraccionesController">
    <children>
        <VBox spacing="5.0">
            <children>
                <Label text="Monitoreo y Gestión de Atracciones" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Estado operativo y estadísticas de uso en tiempo real." textFill="#64748b" />
            </children>
        </VBox>

        <TableView fx:id="tblAtracciones" prefHeight="380.0" prefWidth="620.0" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID Atracción" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado Actual" />
                <TableColumn fx:id="colContadorUso" prefWidth="148.0" text="Contador de Uso" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizarClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-background-radius: 8;" text="🔄 Actualizar Tabla">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
</VBox>
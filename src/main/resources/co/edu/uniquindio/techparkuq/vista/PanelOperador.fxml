<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="580" prefWidth="800" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.techparkuq.controlador.PanelOperadorController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #00542E; -fx-padding: 14;">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="Panel de Operador — Tech-Park UQ" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblInfoOperador" style="-fx-text-fill: #C8E6C9; -fx-font-size: 13;" text="Operador" />
            <Button onAction="#onVolverLogin" style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;" text="← Volver" />
        </HBox>
    </top>

    <center>
        <TabPane style="-fx-background-color: #f5f5f5;" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Mis Atracciones">
                <VBox spacing="10" style="-fx-padding: 14;">
                    <Label fx:id="lblZonaInfo" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" text="Zona: —" />
                    <TableView fx:id="tblMisAtracciones" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colOpNombre" prefWidth="190" text="Atracción" />
                            <TableColumn fx:id="colOpEstado" prefWidth="130" text="Estado" />
                            <TableColumn fx:id="colOpContador" prefWidth="130" text="Visitantes Acum." />
                            <TableColumn fx:id="colOpEspera" prefWidth="110" text="Espera (min)" />
                            <TableColumn fx:id="colOpAltura" prefWidth="105" text="Alt. Mín (m)" />
                            <TableColumn fx:id="colOpEdad" prefWidth="90" text="Edad Mín." />
                        </columns>
                    </TableView>
                    <Button onAction="#onRefrescarAtracciones" style="-fx-background-color: #00542E; -fx-text-fill: white;" text="Actualizar tabla" />
                </VBox>
            </Tab>

            <Tab text="Control de Atracción">
                <VBox spacing="14" style="-fx-padding: 22;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Cambiar estado de una atracción" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Atracción:" />
                        <ComboBox fx:id="cmbCtrlAtraccion" onAction="#onSeleccionarAtraccion" prefWidth="260" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Estado actual:" />
                        <Label fx:id="lblEstadoActual" style="-fx-font-weight: bold; -fx-font-size: 14;" text="—" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Nuevo estado:" />
                        <ComboBox fx:id="cmbNuevoEstado" prefWidth="200" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Motivo cierre:" />
                        <TextField fx:id="txtMotivoCierre" prefWidth="300" promptText="(obligatorio al cerrar)" />
                    </HBox>

                    <Button onAction="#onCambiarEstado" prefWidth="190" style="-fx-background-color: #00542E; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar Estado" />
                    <Label fx:id="lblResultadoControl" style="-fx-text-fill: #1565C0; -fx-font-weight: bold;" text="" />
                </VBox>
            </Tab>

            <Tab text="Revisión Técnica">
                <VBox spacing="14" style="-fx-padding: 22;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Registrar Revisión Técnica" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="150" text="Atracción:" />
                        <ComboBox fx:id="cmbMantAtraccion" onAction="#onSeleccionarAtraccionMant" prefWidth="260" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="150" text="Estado:" />
                        <Label fx:id="lblMantEstado" style="-fx-font-weight: bold;" text="—" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="150" text="Visitantes acum.:" />
                        <Label fx:id="lblMantContador" style="-fx-font-weight: bold;" text="0" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="150" text="Necesita revisión:" />
                        <Label fx:id="lblNecesitaRevision" style="-fx-font-weight: bold;" text="—" />
                    </HBox>

                    <Button onAction="#onRegistrarRevision" prefWidth="240" style="-fx-background-color: #E65100; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrar Revisión Técnica" />

                    <TextArea fx:id="areaLogMant" editable="false" prefHeight="160" promptText="Historial de revisiones..." />
                </VBox>
            </Tab>

            <Tab text="Validar Acceso">
                <VBox spacing="14" style="-fx-padding: 22;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Validar Acceso de un Visitante a la Atracción" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Visitante:" />
                        <ComboBox fx:id="cmbVisitante" prefWidth="280" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="130" text="Atracción:" />
                        <ComboBox fx:id="cmbValidarAtraccion" prefWidth="280" />
                    </HBox>

                    <Button onAction="#onValidarAcceso" prefWidth="180" style="-fx-background-color: #00542E; -fx-text-fill: white; -fx-font-weight: bold;" text="Validar Acceso" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-weight: bold;" text="Resultado:" />
                        <Label fx:id="lblResultadoAcceso" style="-fx-font-size: 14;" text="—" />
                    </HBox>
                </VBox>
            </Tab>


            <Tab text="Cola Virtual">
                <VBox spacing="12" style="-fx-padding: 18;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Gestión de Cola Virtual" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="120" text="Atracción:" />
                        <ComboBox fx:id="cmbColaAtraccion" onAction="#onSeleccionarAtraccionCola" prefWidth="260" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label fx:id="lblColaTamanio" style="-fx-font-weight: bold; -fx-text-fill: #1565C0;" text="Personas en espera: 0" />
                        <Label fx:id="lblColaTiempoEspera" style="-fx-font-weight: bold; -fx-text-fill: #E65100;" text="Tiempo estimado: 0 min" />
                    </HBox>

                    <Label style="-fx-font-weight: bold;" text="Cola actual (⭐ = Fast-Pass):" />
                    <ListView fx:id="listCola" prefHeight="150" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="120" text="Agregar visitante:" />
                        <ComboBox fx:id="cmbColaVisitante" prefWidth="260" />
                    </HBox>

                    <HBox spacing="10">
                        <Button onAction="#onAgregarACola" prefWidth="170" style="-fx-background-color: #00542E; -fx-text-fill: white; -fx-font-weight: bold;" text="➕ Agregar a Cola" />
                        <Button onAction="#onAtenderSiguiente" prefWidth="170" style="-fx-background-color: #E65100; -fx-text-fill: white; -fx-font-weight: bold;" text="▶ Atender Siguiente" />
                        <Button onAction="#onRefrescarCola" style="-fx-background-color: #555; -fx-text-fill: white;" text="🔄 Refrescar" />
                    </HBox>

                    <Label fx:id="lblColaResultado" style="-fx-font-size: 13; -fx-font-weight: bold;" text="" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>

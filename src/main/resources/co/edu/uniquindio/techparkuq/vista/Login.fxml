<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="460" prefWidth="480" spacing="0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.techparkuq.controlador.LoginController">

    <VBox alignment="CENTER" prefHeight="90.0" prefWidth="480.0" spacing="6" style="-fx-background-color: #00542E; -fx-padding: 30;">
        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;" text="TECH-PARK UQ" />
        <Label style="-fx-font-size: 13; -fx-text-fill: #BBDEFB;" text="Sistema de Gestión de Parque Inteligente" />
    </VBox>

    <VBox alignment="CENTER" prefHeight="306.0" prefWidth="480.0" spacing="22" style="-fx-padding: 30; -fx-background-color: #f5f5f5;" VBox.vgrow="ALWAYS">

        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #333;" text="Seleccione su tipo de usuario:" />

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="btnAdmin" onAction="#onAdminClick" prefHeight="65" prefWidth="130" style="-fx-background-color: #8D8F8D; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;" text="Administrador" />
            <Button fx:id="btnOperador" onAction="#onOperadorClick" prefHeight="65" prefWidth="130" style="-fx-background-color: #8D8F8D; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;" text="Operador" />
            <Button fx:id="btnVisitante" onAction="#onVisitanteClick" prefHeight="65" prefWidth="130" style="-fx-background-color: #8D8F8D; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;" text="Visitante" />
        </HBox>

        <VBox fx:id="panelCredencial" alignment="CENTER" managed="false" spacing="10" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 20;" visible="false">
            <Label fx:id="lblDocumento" style="-fx-font-weight: bold;" text="Número de documento:" />
            <TextField fx:id="txtDocumento" prefWidth="260" promptText="Ingrese su número de documento" />
            <Button onAction="#onIngresarClick" prefWidth="200" style="-fx-background-color: #424242; -fx-text-fill: white; -fx-font-weight: bold;" text="Ingresar al Sistema" />
            <Button onAction="#onCancelarClick" prefWidth="200" style="-fx-background-color: #888; -fx-text-fill: white;" text="Cancelar" />
        </VBox>
    </VBox>

    <HBox alignment="CENTER" style="-fx-background-color: #e0e0e0; -fx-padding: 8;">
        <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Universidad del Quindío  |  Programación I - 2026" />
    </HBox>
</VBox>
